# Generic API. A company host such as ej.localhost keeps this protocol and
# port and swaps in that hostname. Every other host calls this URL as written.
API_BASE_URL=http://127.0.0.1:8000

# This app. Sent as the Origin on API calls, so the backend must list it in
# CSRF_TRUSTED_ORIGINS. Company localhost sites use the same port on their
# own hostname (http://ej.localhost:3001). On Vercel, set the deployment URL.
APP_URL=http://localhost:3001

# Scoring / respondent API. Defaults to API_BASE_URL when unset.
CLIENT_API_BASE=http://127.0.0.1:8000

# Optional. Campaign name and community slug for the scoring replay.
# CLIENT_API_CAMPAIGN=company-x
# CLIENT_API_COMMUNITY=company-x
