# Generic API. Each company is served at API_BASE_URL/t/<company>/, and this
# portal opens it at /<company>, e.g. http://localhost:3001/ej/login.
API_BASE_URL=http://127.0.0.1:8000

# This app, without a company path. Sent as the Origin on API calls, so the
# backend must list it in CSRF_TRUSTED_ORIGINS. On Vercel, set the site URL.
APP_URL=http://localhost:3001

# Scoring / respondent API. Defaults to API_BASE_URL when unset.
CLIENT_API_BASE=http://127.0.0.1:8000

# Optional. Campaign name and community slug for the scoring replay.
# CLIENT_API_CAMPAIGN=company-x
# CLIENT_API_COMMUNITY=company-x
