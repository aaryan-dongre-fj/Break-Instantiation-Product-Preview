# Optional overrides. Company name, logo, port, and the API origin live in
# instance.config.json. Set these only when a deploy should differ from that file.
# STAFF_API_BASE=http://127.0.0.1:8000
# CLIENT_API_BASE=http://127.0.0.1:8000
# Optional. If unset, each product's code is used as the community campaign.
# CLIENT_API_CAMPAIGN=company-x
